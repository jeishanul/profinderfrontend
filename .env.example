# Public site URL used by @nuxtjs/seo for canonical URLs, sitemap, robots, and OG images.
# Local dev server runs on port 3838 (see nuxt.config.ts -> devServer.port).
NUXT_PUBLIC_SITE_URL=http://localhost:3838

# Set to "true" only in the environment that should actually be indexed by search engines.
NUXT_SITE_INDEXABLE=false

# Stable secret for signing OG image URLs. Required for rolling/multi-instance production
# deploys (without it, each instance/build generates its own secret and signed URLs from one
# instance 404 on another). Not needed for local dev or single-instance deploys.
# Generate with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=

# The real Laravel API this app's server/api/* routes proxy to (server-side only —
# see server/utils/apiProxy.ts and CLAUDE.md's Data fetching section). Point this at
# wherever `php artisan serve` (or your real deploy) is running.
NUXT_API_BASE_URL=http://127.0.0.1:8123

# Social login — same client IDs as backend GOOGLE_CLIENT_ID / FACEBOOK_CLIENT_ID.
NUXT_SOCIAL_GOOGLE_CLIENT_ID=
NUXT_SOCIAL_FACEBOOK_CLIENT_ID=
